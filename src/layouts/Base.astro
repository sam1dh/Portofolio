---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Sameen Dhanimisetti · sameen.os',
  description = 'AI + backend engineer building voice agents, RAG pipelines and fast backends. Final-year CS at VIT, open to 2027 roles.',
  image = '/og.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#CFC8F2" />

    <!-- how your link looks when shared -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="sameen.os" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      try {
        if (!location.search.includes('intro') && sessionStorage.getItem('sameen-os-booted') === '1')
          document.documentElement.classList.add('booted');
      } catch (e) {}
    </script>
  </head>
  <body class="bg-wall text-ink font-sans antialiased">
    <slot />
  </body>
</html>
