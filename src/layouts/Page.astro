---
import Base from './Base.astro';
import MenuBar from '../components/os/MenuBar';
import Dock from '../components/os/Dock';

interface Props {
  title: string;
  path: string;
  back: string;
  description?: string;
}

const { title, path, back, description } = Astro.props;
---

<Base title={`${title} · sameen.os`} description={description}>
  <div class="flex min-h-dvh flex-col">
    <MenuBar client:idle />
    <main class="flex-1 p-3 sm:p-6">
      <div class="page-in mx-auto max-w-3xl overflow-hidden rounded-win border border-ink bg-win">
        <div class="flex items-center gap-1.5 border-b border-ink bg-titlebar px-3 py-2 font-mono text-xs">
          <a href={back} aria-label="Close and go back" class="size-2.5 rounded-full border border-ink bg-[#F09595] hover:brightness-90"></a>
          <span class="size-2.5 rounded-full border border-ink bg-[#FAC775]"></span>
          <span class="size-2.5 rounded-full border border-ink bg-[#97C459]"></span>
          <span class="ml-2 truncate">{path}</span>
          <a href={back} class="ml-auto shrink-0 underline underline-offset-2">← back</a>
        </div>
        <slot />
      </div>
    </main>
    <div class="sticky bottom-3 flex justify-center pb-3" style="view-transition-name: dock">
      <Dock
        items={[
          { label: 'me', href: '/' },
          { label: '~/projects', href: '/projects' },
          { label: '~/work', href: '/internships' },
          { label: 'fun', href: '/hobbies' },
          { label: 'cv', href: '/resume.pdf' },
          { label: '@', href: 'mailto:sameendhanimisetti@gmail.com', primary: true },
        ]}
      />
    </div>
  </div>
</Base>
