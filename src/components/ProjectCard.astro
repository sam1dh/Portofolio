---
import { TINTS, type Tint } from '../lib/tints';

interface Props {
  href: string;
  icon: string;
  title: string;
  subtitle: string;
  year: string;
  tags: string[];
  tint: Tint;
  badge?: string;
  index: number;
}

const { href, icon, title, subtitle, year, tags, tint, badge, index } = Astro.props;
const t = TINTS[tint];
const tilt = ['-rotate-[1.5deg]', 'rotate-[1.2deg]', '-rotate-[0.8deg]'][index % 3];
---

<a
  href={href}
  class={`rise block overflow-hidden rounded-xl border border-ink bg-win transition-[rotate,translate] duration-300 hover:-translate-y-1.5 hover:rotate-0 ${tilt}`}
  style={`animation-delay:${index * 110}ms`}
>
  <div class={`flex items-start justify-between border-b border-ink p-4 ${t.bg}`}>
    <span class={`grid h-[42px] w-12 place-items-center rounded-lg border border-ink bg-win font-mono text-sm font-medium ${t.ink}`}>{icon}</span>
    <span class={`font-mono text-xs ${t.ink}`}>{year}</span>
  </div>
  <div class="p-4">
    <h2 class="font-serif text-[28px] leading-none">{title}</h2>
    <p class="mt-1.5 text-[13px] leading-snug text-sub">{subtitle}</p>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {tags.slice(0, 3).map((s) => <span class="pill">{s}</span>)}
    </div>
    {badge && <p class="mt-3 font-mono text-xs text-[#854F0B]">✦ {badge}</p>}
    <p class="mt-3 font-mono text-xs text-accent">open →</p>
  </div>
</a>
