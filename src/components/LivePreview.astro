---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const host = new URL(url).host;
---

<div class="live-preview overflow-hidden rounded-win border border-ink" data-url={url} data-title={title}>
  <div class="flex items-center gap-1.5 border-b border-ink bg-titlebar px-3 py-2 font-mono text-xs">
    <span class="size-2.5 rounded-full border border-ink bg-[#F09595]"></span>
    <span class="size-2.5 rounded-full border border-ink bg-[#FAC775]"></span>
    <span class="size-2.5 rounded-full border border-ink bg-[#97C459]"></span>
    <span class="ml-2 truncate">{host}</span>
    <a href={url} target="_blank" rel="noopener noreferrer" class="ml-auto shrink-0 underline underline-offset-2">open ↗</a>
  </div>
  <div class="frame grid aspect-[3/4] place-items-center bg-menu sm:aspect-[16/10]">
    <button type="button" class="load rounded-lg border border-ink bg-ink px-4 py-2 font-mono text-xs text-win">
      load live preview
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.live-preview').forEach((box) => {
    box.querySelector('.load')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = box.dataset.url!;
      iframe.title = `${box.dataset.title} live preview`;
      iframe.className = 'h-full w-full';
      box.querySelector('.frame')!.replaceChildren(iframe);
    });
  });
</script>
