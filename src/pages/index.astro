---
import Base from '../layouts/Base.astro';
---

<Base title="sameen.os">
  <main class="min-h-screen grid place-items-center p-6">
    <div class="bg-win border border-ink rounded-win overflow-hidden w-full max-w-md">
      <div class="flex items-center gap-1.5 px-3 py-2 border-b border-ink bg-titlebar font-mono text-xs">
        <span class="size-2.5 rounded-full border border-ink bg-[#F09595]"></span>
        <span class="size-2.5 rounded-full border border-ink bg-[#FAC775]"></span>
        <span class="size-2.5 rounded-full border border-ink bg-[#97C459]"></span>
        <span class="ml-2">setup_check.txt</span>
      </div>
      <div class="p-5">
        <h1 class="font-serif text-4xl leading-none">hi, i'm <em>sameen</em>.</h1>
        <p class="mt-2 text-sm text-sub">If this is lavender with a serif heading, step 1 worked.</p>
        <p class="mt-3 font-mono text-xs text-accent">fonts ✓ tokens ✓ tailwind ✓</p>
      </div>
    </div>
  </main>
</Base>
