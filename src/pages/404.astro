---
import Base from '../layouts/Base.astro';
---

<Base title="404 · sameen’s lab" description="This page doesn't exist.">
  <main class="grid min-h-dvh place-items-center p-6">
    <div class="page-in w-full max-w-sm overflow-hidden rounded-win border border-ink bg-win">
      <div class="flex items-center gap-1.5 border-b border-ink bg-titlebar px-3 py-2 font-mono text-xs">
        <span class="size-2.5 rounded-full border border-ink bg-[#F09595]"></span>
        <span class="size-2.5 rounded-full border border-ink bg-[#FAC775]"></span>
        <span class="size-2.5 rounded-full border border-ink bg-[#97C459]"></span>
        <span class="ml-2">error.app</span>
      </div>
      <div class="p-6 text-center">
        <div class="mx-auto flex w-fit flex-col items-center" aria-hidden="true">
          <div class="flex h-[80px] w-[104px] justify-center rounded-xl border border-ink bg-win pt-2">
            <div class="relative h-[50px] w-[80px] rounded-md border border-ink bg-[#AFA9EC]">
              <span class="absolute left-[22px] top-[10px] font-mono text-sm leading-none">×</span>
              <span class="absolute right-[22px] top-[10px] font-mono text-sm leading-none">×</span>
              <span class="absolute bottom-[10px] left-1/2 h-1.5 w-4 -translate-x-1/2 rounded-t-full border-[1.5px] border-b-0 border-ink"></span>
            </div>
          </div>
          <div class="h-2.5 w-5 border-x border-ink bg-win"></div>
          <div class="h-2 w-16 rounded border border-ink bg-win"></div>
        </div>
        <h1 class="mt-5 font-serif text-3xl leading-none">this folder <em>doesn't exist</em>.</h1>
        <p class="mt-2 text-sm text-sub">The link might be old, or it got lost on the way. Everything else is still on the desktop.</p>
        <div class="mt-5 flex justify-center gap-2">
          <a href="/" class="btn bg-ink text-win">back to desktop</a>
          <a href="/projects" class="btn">see projects</a>
        </div>
        <p class="mt-4 font-mono text-[11px] text-sub">error 404 · file not found</p>
      </div>
    </div>
  </main>
</Base>
