---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Desktop from '../../components/os/Desktop';
import { getContributions } from '../../lib/github';
import { getFolders } from '../../lib/folders';

export async function getStaticPaths() {
  const all = await getCollection('internships');
  return all.map((w) => ({
    params: { slug: w.id },
    props: { title: w.data.company, description: `${w.data.role} at ${w.data.company}` },
  }));
}

const { slug } = Astro.params;
const { title, description } = Astro.props;
const folders = await getFolders();
const contributions = await getContributions();
---

<Base title={`${title} · sameen.os`} description={description}>
  <Desktop client:load folders={folders} contributions={contributions} initial={{ folder: 'internships', item: slug }} />
</Base>
